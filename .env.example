# Server
PORT=3000

# MongoDB (docker compose exposes it on localhost:27017)
DATABASE=mongodb://localhost:27017/lsec
DATABASE_TEST=mongodb://localhost:27017/lsec_test

# Auth
JWT_SECRET=change-me

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial admin user created by `pnpm seed`
ADMIN_NAME=admin
ADMIN_EMAIL=admin@lsec.local
ADMIN_PASSWORD=change-me
