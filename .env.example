# Server
PORT=5000
# Origins allowed by CORS, separated by commas
CORS_ORIGINS=http://localhost:3000
# fatal, error, warn, info, debug, trace or silent (default: info)
LOG_LEVEL=info

# MongoDB (docker compose exposes it on localhost:27017)
DATABASE=mongodb://localhost:27017/lsec
DATABASE_TEST=mongodb://localhost:27017/lsec_test

# Auth: at least 32 characters. Generate it with: openssl rand -hex 32
JWT_SECRET=

# Cloudinary (required in production; without it, uploads fail with a 502)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial admin user created by `pnpm seed` (password: at least 8 characters)
ADMIN_NAME=admin
ADMIN_EMAIL=admin@lsec.local
ADMIN_PASSWORD=
