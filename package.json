{
  "name": "lsec-api-rest",
  "version": "2.2.1",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "start": "node src/server.js",
    "start:test": "cross-env NODE_ENV=test node --watch src/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --verbose --detectOpenHandles --runInBand",
    "test:watch": "pnpm test --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "seed": "node src/scripts/seed.js",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "mongoose-paginate-v2": "^1.9.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
